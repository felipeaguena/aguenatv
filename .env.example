# Turso Database (libSQL / SQLite Serverless Gratuito sem pausa)
TURSO_DATABASE_URL=libsql://aguenatv-seu-usuario.turso.io
TURSO_AUTH_TOKEN=seu_token_gerado_no_turso

# Chave Secreta para Assinatura de Tokens JWT (Mínimo 32 caracteres)
JWT_SECRET=gere_uma_chave_secreta_com_pelo_menos_32_caracteres_aleatorios

# The Movie Database (TMDb) - API Key gratuita obtida em themoviedb.org
TMDB_API_KEY=sua_chave_api_tmdb_aqui
