# Turso Database (libSQL / SQLite Serverless Gratuito sem pausa)
# Obtenha em: https://turso.tech
TURSO_DATABASE_URL=libsql://aguenatv-seu-usuario.turso.io
TURSO_AUTH_TOKEN=seu_token_gerado_no_turso

# Chave Secreta para Assinatura de Tokens JWT (Obrigatório: gere com crypto.randomBytes(32).toString('hex'))
JWT_SECRET=defina_uma_chave_secreta_forte_com_no_minimo_32_caracteres_aleatorios

# The Movie Database (TMDb) - API Key gratuita obtida em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_api_tmdb_aqui
